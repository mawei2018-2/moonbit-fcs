///|
fn duplicate_writer_fixture(hex : String) -> Bytes {
  let digit = fn(index : Int) -> Int {
    let value = hex[index].to_int()
    if value <= 57 {
      value - 48
    } else {
      value - 87
    }
  }
  Bytes::makei(hex.length() / 2, i => {
    (digit(i * 2) * 16 + digit(i * 2 + 1)).to_byte()
  })
}

///|
test "duplicate writer labels stay positional during list conversion" {
  let original = parse(
    duplicate_writer_fixture(
      "",
    ),
  )
  let output = parse(
    original.write(channel_indices=[1, 0], encoding={
      kind: Float64,
      widths: [64, 64],
      order: BigEndian,
    }),
  )
  assert_eq(output.channel_info().map(c => c.name), ["DUP", "DUP"])
  assert_eq(output.channel_info().map(c => c.stain), ["right", "left"])
  assert_eq(output.value(0, 0), 3.0)
  assert_eq(output.value(2, 1), 5.0)
  assert_eq(output.channel_info().map(c => c.gain), [1.0, 1.0])
  assert_eq(output.warnings(), [
    "duplicate channel name DUP; use numeric indexes",
  ])
  assert_eq(original.integer_text(0, 0), "4")
}

///|
test "duplicate writer C axes retain frequencies and COMP positions" {
  let original = parse(
    duplicate_writer_fixture(
      "",
    ),
  )
  let output = parse(original.write(channel_indices=[1, 0]))
  assert_eq(output.histogram_shape(), [3, 2])
  assert_eq(output.histogram_frequencies(), ["1", "3", "5", "2", "4", "6"])
  assert_eq(output.channel_info().map(c => c.stain), ["right", "left"])
  assert_eq(output.keyword("$COMP"), Some("2,1,0.50,0.25,1"))
  assert_eq(original.histogram_frequencies(), ["1", "2", "3", "4", "5", "6"])
}

///|
test "duplicate writer U axes retain independent marginal blocks" {
  let original = parse(
    duplicate_writer_fixture(
      "",
    ),
  )
  let output = parse(original.write(channel_indices=[1, 0]))
  assert_eq(output.histogram_shape(), [3, 2])
  assert_eq(output.histogram_frequencies(), ["2", "5", "8", "6", "9"])
  assert_eq(output.histogram_axis(0), ["2", "5", "8"])
  assert_eq(output.histogram_axis(1), ["6", "9"])
  assert_eq(output.keyword("$COMP"), Some("2,1,0.50,0.25,1"))
}

///|
test "duplicate writer fix retains creation-only unique-name rules" {
  try
    create(["DUP", "DUP"], [], integer_values=["1", "2"], encoding={
      kind: Integer,
      widths: [16, 16],
      order: LittleEndian,
    })
  catch {
    Invalid(_) => ()
    _ => fail("unexpected creation error")
  } noraise {
    _ => fail("creation accepted duplicate names")
  }
  try
    create_histogram(
      ["DUP", "DUP"],
      [2, 3],
      ["1", "2", "3", "4", "5", "6"],
      mode=Correlated,
      encoding={ kind: Integer, widths: [16, 16], order: LittleEndian, },
    )
  catch {
    Invalid(_) => ()
    _ => fail("unexpected histogram creation error")
  } noraise {
    _ => fail("histogram creation accepted duplicate names")
  }
}
